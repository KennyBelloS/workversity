# Variables del correo de recuperación (función /api/recuperar-clave).
# NO se ponen en el archivo .env del frontend: van en Vercel → Settings → Environment Variables.
# Para probar en tu computador con `npm run preview:api`, copia este archivo como `.env.local`
# (nunca lo subas a GitHub).

# Del proyecto de Supabase de WORKVERSITY (Settings → API). Sin el prefijo VITE_.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-de-workversity

# Proveedor de correo: resend (plan gratis: 3.000 correos al mes, 100 al día).
PROVEEDOR_CORREO=resend
RESEND_API_KEY=re_...

# Remitente. Con un dominio verificado en resend.com/domains: "Workversity <hola@tu-dominio.com>".
# Sin dominio (solo para probar): "Workversity <onboarding@resend.dev>". En ese modo Resend
# solo entrega al correo con el que creaste tu cuenta de Resend.
CORREO_REMITENTE=Workversity <onboarding@resend.dev>

# Dirección pública de la app en Vercel (sin barra al final). El enlace del correo lleva a
# URL_PUBLICA/nueva-clave, y el logo se toma de URL_PUBLICA/logo.png.
URL_PUBLICA=https://tu-app.vercel.app

# Opcional: si pones un correo aquí, TODOS los correos se desvían a esa dirección (para probar).
# Mientras no tengas dominio, pon aquí el MISMO correo de tu cuenta de Resend.
CORREO_PRUEBAS=

# Opcional: otra dirección pública para el logo (si no, se usa URL_PUBLICA/logo.png).
LOGO_URL=

# Alternativa: Brevo (PROVEEDOR_CORREO=brevo + BREVO_API_KEY=xkeysib-...)
